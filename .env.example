# ---------------------------------------------------------------------------
# Supabase (public — safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ---------------------------------------------------------------------------
# Speechmatics (server-side only — never expose the raw API key)
# The browser receives a short-lived JWT from /api/speech/token instead.
#
# SPEECHMATIC_API_KEY (singular) is the older spelling and is still accepted,
# so an existing deployment keeps working without re-entering the secret.
# ---------------------------------------------------------------------------
SPEECHMATICS_API_KEY="your-speechmatics-api-key"
# Conversation template Flow uses for Roisin. See the Flow template discovery
# endpoint for the current list of published templates.
SPEECHMATICS_FLOW_TEMPLATE_ID="flow-service-assistant-amelia"
# Identifies this app in Speechmatics telemetry.
SPEECHMATICS_APP_ID="orbit-roisin"
# Seconds a minted JWT stays valid. Keep this short.
SPEECHMATICS_JWT_TTL="120"

# ---------------------------------------------------------------------------
# Roisin's reasoning model — used to turn speech into native.builder prompts.
# Any OpenAI-compatible chat-completions gateway works.
#
# MLAI_API_KEY is the older name for an AI/ML API key and is still accepted.
# The default base URL points at AI/ML API to match it, so an existing
# deployment needs no new variables.
# ---------------------------------------------------------------------------
LLM_BASE_URL="https://api.aimlapi.com/v1"
LLM_API_KEY="your-model-gateway-key"
LLM_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# native.builder — the product Roisin drives. It has no public API, so the
# desktop shell hosts the web app and Roisin types into its chat surface.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NATIVE_BUILDER_URL="https://builder.nativelyai.com"

# ---------------------------------------------------------------------------
# Bright Data (optional — research/scraping actions)
# ---------------------------------------------------------------------------
BRIGHTDATA_API_KEY="your-bright-data-key"
# Zone names from your Bright Data account (Proxies & Scraping -> zones).
BRIGHTDATA_SERP_ZONE="serp_api1"
BRIGHTDATA_UNLOCKER_ZONE="web_unlocker1"

# ---------------------------------------------------------------------------
# GitHub App — used by /api/github/commit to write files on a user's behalf.
# Paste the whole .pem contents, including the BEGIN/END lines.
# ---------------------------------------------------------------------------
# Repositories Roisin may write specs into. First one is the default.
# The App is installed org-wide with contents:write, so this allowlist is what
# stops a signed-in account writing anywhere in the organisation.
GITHUB_SCAFFOLD_REPOS="Nextwork-Houston/demo-repository"
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
