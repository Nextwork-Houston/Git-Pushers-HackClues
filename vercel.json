{
  "rewrites": [
    { "source": "/orbit", "destination": "/orbit/demo.html" }
  ],
  "headers": [
    {
      "source": "/orbit/downloads/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
